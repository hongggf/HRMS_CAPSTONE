generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles         UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  workforceRequestsCreated  WorkforceRequest[] @relation("WorkforceRequestedBy")
  workforceRequestsApproved WorkforceRequest[] @relation("WorkforceApprovedBy")
  workforceRequestsRejected WorkforceRequest[] @relation("WorkforceRejectedBy")
  
  jobRequisitionsRequested  JobRequisition[]   @relation("RequisitionRequestedBy")
  interviewsConducted       Interview[]        @relation("InterviewInterviewer")
  statusHistoryChanges      CandidateStatusHistory[] @relation("StatusHistoryChangedBy")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          Int      @id @default(autoincrement())
  action      String   @unique
  
  roles       RolePermission[]
}

model UserRole {
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  userId    Int?
  details   String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([action])
}

// ========== Phase 3: Organization Structure & Workforce Planning ==========

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum PositionStatus {
  OPEN
  CLOSED
  FROZEN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum WorkforceStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

model Department {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  code        String           @unique
  description String?
  status      DepartmentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  positions         Position[]
  workforceRequests  WorkforceRequest[]

  @@index([code])
}

model Position {
  id             Int            @id @default(autoincrement())
  title          String
  code           String         @unique
  departmentId   Int
  description    String?
  employmentType EmploymentType @default(FULL_TIME)
  salaryMin      Float?
  salaryMax      Float?
  status         PositionStatus @default(OPEN)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  department        Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  workforceRequests  WorkforceRequest[]

  @@index([departmentId])
  @@index([code])
}

model WorkforceRequest {
  id              Int             @id @default(autoincrement())
  departmentId    Int
  positionId      Int
  requestedBy     Int
  headcount       Int
  justification   String
  status          WorkforceStatus @default(DRAFT)
  approvedBy      Int?
  approvedAt      DateTime?
  rejectedBy      Int?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  department  Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  position    Position   @relation(fields: [positionId], references: [id], onDelete: Restrict)
  requester   User       @relation("WorkforceRequestedBy", fields: [requestedBy], references: [id], onDelete: Restrict)
  approver    User?      @relation("WorkforceApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  rejector    User?      @relation("WorkforceRejectedBy", fields: [rejectedBy], references: [id], onDelete: SetNull)
  
  jobRequisition JobRequisition?

  @@index([departmentId])
  @@index([positionId])
  @@index([requestedBy])
  @@index([status])
}

// ========== Phase 4: Recruitment ==========

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CLOSED
}

enum JobPostingStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW
  SELECTED
  PENDING_HEAD_OF_HR_APPROVAL
  APPROVED
  REJECTED
  WITHDRAWN
  HIRED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum InterviewType {
  HR
  TECHNICAL
  BEHAVIORAL
  FINAL
}

model JobRequisition {
  id                 Int               @id @default(autoincrement())
  workforceRequestId Int               @unique
  requestedBy        Int
  status             RequisitionStatus @default(DRAFT)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  workforceRequest   WorkforceRequest  @relation(fields: [workforceRequestId], references: [id], onDelete: Restrict)
  requester          User              @relation("RequisitionRequestedBy", fields: [requestedBy], references: [id], onDelete: Restrict)
  jobPosting         JobPosting?
}

model JobPosting {
  id             Int              @id @default(autoincrement())
  requisitionId  Int              @unique
  title          String
  description    String
  requirements   String
  location       String
  employmentType EmploymentType
  openingDate    DateTime
  closingDate    DateTime?
  status         JobPostingStatus @default(DRAFT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  requisition    JobRequisition   @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  applications   Application[]
}

model Candidate {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String   @unique
  phone     String?
  resumeUrl String?
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
}

model Application {
  id            Int               @id @default(autoincrement())
  candidateId   Int
  jobPostingId  Int
  status        ApplicationStatus @default(APPLIED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  candidate     Candidate                @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobPosting    JobPosting               @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  interviews    Interview[]
  statusHistory CandidateStatusHistory[]

  @@unique([candidateId, jobPostingId])
}

model Interview {
  id            Int             @id @default(autoincrement())
  applicationId Int
  interviewerId Int
  scheduledAt   DateTime
  type          InterviewType
  location      String?
  status        InterviewStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  application   Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer   User                 @relation("InterviewInterviewer", fields: [interviewerId], references: [id], onDelete: Restrict)
  evaluation    InterviewEvaluation?
}

model InterviewEvaluation {
  id             Int      @id @default(autoincrement())
  interviewId    Int      @unique
  score          Float
  strengths      String
  weaknesses     String
  recommendation String
  comments       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  interview      Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

model CandidateStatusHistory {
  id            Int               @id @default(autoincrement())
  applicationId Int
  status        ApplicationStatus
  changedById   Int?
  notes         String?
  createdAt     DateTime          @default(now())

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy     User?       @relation("StatusHistoryChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
}
